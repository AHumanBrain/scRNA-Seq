// =========================================================================
// scRNA-Seq Pipeline Configuration
// =========================================================================
// Two profiles available:
//   -profile local   → For laptops/desktops (downstream only: Scanpy, MultiQC)
//   -profile server  → For HPC/cloud (full pipeline: bcl2fastq, STARsolo, etc.)
// =========================================================================

profiles {

    // -----------------------------------------------------------------
    // LOCAL profile: For machines with limited RAM (e.g. 12 GB)
    // Can run: FETCH_DATA, FASTQC, SCANPY_ANALYSIS, MULTIQC
    // Cannot run: BCL2FASTQ, STAR_INDEX, STARSOLO (need 32-64 GB RAM)
    // -----------------------------------------------------------------
    local {
        docker.enabled = true

        process {
            withName: FETCH_DATA {
                container = 'ubuntu:22.04'
                memory    = '1 GB'
                cpus      = 1
            }
            withName: FASTQC {
                container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
                memory    = '4 GB'
                cpus      = 4
            }
            withName: SCANPY_ANALYSIS {
                container = 'scanpy-analysis:latest'
                memory    = '5 GB'
                cpus      = 2
            }
            withName: MULTIQC {
                container = 'scanpy-analysis:latest'
                memory    = '2 GB'
                cpus      = 1
            }
        }
    }

    // -----------------------------------------------------------------
    // SERVER profile: For high-memory machines, HPC, or cloud instances
    // Can run all stages including BCL2FASTQ, STAR_INDEX, STARSOLO
    // Minimum recommended: 64 GB RAM, 16 CPUs
    // -----------------------------------------------------------------
    server {
        docker.enabled = true

        process {
            withName: FETCH_DATA {
                container = 'ubuntu:22.04'
                memory    = '1 GB'
                cpus      = 1
            }
            withName: BCL2FASTQ {
                container = 'quay.io/biocontainers/bcl2fastq:2.20.0--hd28b015_1'
                memory    = '64 GB'
                cpus      = 16
            }
            withName: FASTQC {
                container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
                memory    = '4 GB'
                cpus      = 4
            }
            withName: STAR_INDEX {
                container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0'
                memory    = '32 GB'
                cpus      = 8
            }
            withName: STARSOLO {
                container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0'
                memory    = '32 GB'
                cpus      = 8
            }
            withName: SCANPY_ANALYSIS {
                container = 'scanpy-analysis:latest'
                memory    = '5 GB'
                cpus      = 2
            }
            withName: MULTIQC {
                container = 'scanpy-analysis:latest'
                memory    = '2 GB'
                cpus      = 1
            }
        }
    }
}

// Default profile if none specified
docker.enabled = true

process {
    withName: FETCH_DATA       { container = 'ubuntu:22.04' }
    withName: BCL2FASTQ        { container = 'quay.io/biocontainers/bcl2fastq:2.20.0--hd28b015_1' }
    withName: FASTQC           { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
    withName: STAR_INDEX       { container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0' }
    withName: STARSOLO         { container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0' }
    withName: SCANPY_ANALYSIS  { container = 'scanpy-analysis:latest'; memory = '5 GB'; cpus = 2 }
    withName: MULTIQC          { container = 'scanpy-analysis:latest'; memory = '2 GB'; cpus = 1 }
}
